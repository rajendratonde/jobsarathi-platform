# Local development only. Copy to .env (git-ignored) and change the values.
# Never put real staging/production credentials in any file in this repo.

# PostgreSQL container (infrastructure/local/docker-compose.yml)
PG_ADMIN_PASSWORD=change-me-local-admin
PG_PORT=5434
# Password for the 16 local service roles (<svc>_service_role, <svc>_migration_role)
LOCAL_DB_PASSWORD=change-me-local

# Tests create throwaway databases with the admin login
TEST_PG_ADMIN_URL=postgresql+psycopg://jobsarathi_admin:change-me-local-admin@127.0.0.1:5434/postgres

# ---- Settings every service reads (shown for running a service outside Docker) ----
# APP_ENV=local                    # local | development | test | staging | production
# SERVICE_NAME=identity
# LOG_FORMAT=text                  # json in every shared environment
# MIDDLEWARE_ENABLED=false
# RUN_MIGRATIONS_ON_START=false    # refused in production
# DB_HOST=127.0.0.1
# DB_PORT=5434
# DB_NAME=identity_db
# DB_USER=identity_service_role
# DB_PASSWORD=env:LOCAL_DB_PASSWORD   # a literal (local only) or a reference: env:NAME / file:/path
# DB_MIGRATION_USER=identity_migration_role
# DB_MIGRATION_PASSWORD=env:LOCAL_DB_PASSWORD

# ---- Email (platform capability; provider not chosen) ----
# EMAIL_MODE=disabled              # disabled | dev_log | smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD_REF=env:SMTP_PASSWORD   # a reference, never the password itself
# EMAIL_SMTP_SECURITY=STARTTLS     # STARTTLS | SSL | NONE
# EMAIL_FROM_EMAIL=
# EMAIL_FROM_NAME=JobSarathi
# EMAIL_REPLY_TO=
# EMAIL_TIMEOUT_SECONDS=10

# ---- SMS / OTP (provider not chosen) ----
# SMS_MODE=disabled                # disabled | dev_log (local/development/test only)
